# Voice Labs local configuration. Never commit a real .env file.

# Local TVIC runtime entrypoint used by the runner.
TVIC_ROOT=/Users/kartik/Desktop/TVIC

# Local Earshot backend used for incident storage and analysis.
EARSHOT_ROOT=/Users/kartik/Desktop/earshot
EARSHOT_ENDPOINT=http://127.0.0.1:4319

# Voice Labs application settings.
VOICE_LABS_HOST=127.0.0.1
VOICE_LABS_PORT=4320
VOICE_LABS_DATA_DIR=./data
VOICE_LABS_ARTIFACT_DIR=./artifacts

# TVIC provider runs are opt-in. When enabled, Voice Labs loads missing provider
# variables from TVIC_ROOT/.env without copying or printing their values.
VOICE_LABS_TVIC_ENABLED=0
VOICE_LABS_LOAD_TVIC_ENV=0
VOICE_LABS_TVIC_STT_PROVIDER=deepgram
VOICE_LABS_TVIC_LLM_PROVIDER=groq
VOICE_LABS_TVIC_TTS_PROVIDER=cartesia
# VOICE_LABS_AUDIO_MANUAL_COMMIT=0
# VOICE_LABS_TVIC_LLM_MODEL=openai/gpt-oss-20b
# VOICE_LABS_TVIC_STT_MODEL=nova-3
# VOICE_LABS_TVIC_TTS_MODEL=sonic-2

# Provider credentials are intentionally absent here. Keep real keys in a local
# environment or TVIC_ROOT/.env and only run provider tiers deliberately.
