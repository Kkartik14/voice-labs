# Local Voice Labs setup. Copy to an ignored .env file and keep real credentials out of source control.

# Local development defaults. The API accepts only loopback callers in this mode.
VOICE_LABS_HOST=127.0.0.1
VOICE_LABS_PORT=4320
VOICE_LABS_AUTH_MODE=local
VOICE_LABS_LOCAL_USER_ID=local-development
VOICE_LABS_LOCAL_PROJECT_ID=local
VOICE_LABS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
VOICE_LABS_STORAGE=json
VOICE_LABS_DATA_DIR=./data
VOICE_LABS_RUN_RETENTION_DAYS=30

# For hosted use, set VOICE_LABS_AUTH_MODE=jwt and VOICE_LABS_STORAGE=postgres.
# The service listens on 0.0.0.0 by default in production; keep it behind a private network/TLS proxy.
# VOICE_LABS_HOST=0.0.0.0
# Optional only for the loopback local summary route; hosted JWT mode uses the scoped Platform token.
# VOICE_LABS_SERVICE_TOKEN=
# Platform access tokens must be signed by this issuer and contain sub and project_id.
# VOICE_LABS_AUTH_MODE=jwt
# VOICE_LABS_AUTH_JWKS_URL=https://platform.example/.well-known/jwks.json
# VOICE_LABS_AUTH_ISSUER=https://platform.example
# VOICE_LABS_AUTH_AUDIENCE=voice-labs
# VOICE_LABS_STORAGE=postgres
# VOICE_LABS_DATABASE_URL=postgresql://user:password@host:5432/voice_labs
# VOICE_LABS_ALLOWED_ORIGINS=https://platform.example

# Provider requests are opt-in. TVIC_ROOT defaults to ../TVIC from this repository.
TVIC_ROOT=../TVIC
VOICE_LABS_AUDIO_ROOT=./audio-fixtures
VOICE_LABS_TVIC_ENABLED=0
VOICE_LABS_LOAD_TVIC_ENV=0
VOICE_LABS_TVIC_STT_PROVIDER=deepgram
VOICE_LABS_TVIC_LLM_PROVIDER=groq
VOICE_LABS_TVIC_TTS_PROVIDER=cartesia
# VOICE_LABS_TVIC_LLM_MODEL=openai/gpt-oss-20b
# VOICE_LABS_TVIC_STT_MODEL=nova-3
# VOICE_LABS_TVIC_TTS_MODEL=sonic-2
# Provider values can remain in TVIC/.env and be loaded process-locally with:
# VOICE_LABS_TVIC_ENABLED=1
# VOICE_LABS_LOAD_TVIC_ENV=1

# Earshot capture is requested per experiment and sends metadata only.
# EARSHOT_ENDPOINT=http://127.0.0.1:4319
# Local single-project configuration; the target project is an Earshot project ID.
# EARSHOT_PROJECT_ID=local
# EARSHOT_PLATFORM_PROJECT_ID=local
# Set EARSHOT_API_KEY in a private environment when Earshot authentication is enabled.
# Hosted multi-project deployments use EARSHOT_PROJECT_MAPPINGS, a JSON object keyed
# by Platform project ID with an earshotProjectId and project-scoped apiKey per entry.
