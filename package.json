{
  "name": "voice-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first simulation and evaluation workspace for voice agents.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "concurrently -k \"tsx src/server/main.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/server/main.ts",
    "lab": "tsx src/cli.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "voice-runtime": "file:../TVIC/packages/voice-runtime",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
